<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat is required for AndroidX per-app locale support; Compose owns the UI. -->
    <style name="Base.Theme.AuraBeauty" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F8F7F2</item>
        <!-- Keep white navigation icons on a dark surface below the API 27 XML flag. -->
        <item name="android:navigationBarColor">#283A2C</item>
        <item name="android:windowBackground">#F8F7F2</item>
    </style>
    <style name="Theme.AuraBeauty" parent="Base.Theme.AuraBeauty" />
</resources>
