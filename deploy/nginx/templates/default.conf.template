# Edge reverse proxy for Aura Beauty Log.
#
# This file is a TEMPLATE. The official Nginx image runs envsubst over
# /etc/nginx/templates at container start and writes the result to
# /etc/nginx/conf.d/default.conf. Only variables exported in the container
# environment (DOMAIN) are substituted — Nginx's own $host, $uri, $remote_addr
# runtime variables are left alone because they are written without braces.

# Rate limit for the auth endpoints. Login and registration are the two routes
# worth brute-forcing, so they get their own bucket: 5 req/s per IP with a
# small burst. Everything else is unthrottled.
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/s;

# ---------------------------------------------------------------------------
# Port 80 — ACME challenges and a permanent redirect to HTTPS.
# ---------------------------------------------------------------------------
server {
    listen      80;
    listen      [::]:80;
    server_name ${DOMAIN} www.${DOMAIN};

    server_tokens off;

    # Certbot writes its proof-of-ownership file here. This location must stay
    # on plain HTTP and must NOT be redirected, or renewal fails.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        # EXTERNAL_HTTPS_SUFFIX is ":<port>" when HTTPS is published on a
        # non-standard host port, and EMPTY when it is on 443 — so the
        # canonical case redirects to https://domain/... with no port at all.
        return 301 https://${DOMAIN}${EXTERNAL_HTTPS_SUFFIX}$request_uri;
    }
}

# ---------------------------------------------------------------------------
# Port 443 — the real site.
# ---------------------------------------------------------------------------
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name ${DOMAIN} www.${DOMAIN};

    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # TLS settings are written inline rather than included from certbot's
    # options-ssl-nginx.conf so that Nginx cannot fail to start because of a
    # missing include, and so the policy is visible and reviewable here.
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;
    ssl_stapling              on;
    ssl_stapling_verify       on;
    resolver                  127.0.0.11 valid=30s;

    # --- Security headers --------------------------------------------------
    # HSTS: tells browsers to only ever use HTTPS for this domain. Add
    # `preload` only once you are certain you will never serve plain HTTP here.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "camera=(self), microphone=(), geolocation=()" always;

    # Attachment uploads are photos; raise the default 1 MB body limit.
    client_max_body_size 20m;

    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_types      text/plain text/css application/javascript application/json image/svg+xml;

    # --- Health probe ------------------------------------------------------
    # Reachable from outside so CI can verify a deploy actually came up.
    # The trailing /health on proxy_pass rewrites the path, since the backend
    # serves its health endpoint at the root, not under /api.
    location = /healthz {
        proxy_pass http://backend:8080/health;
        include /etc/nginx/proxy_params_aura.conf;
        access_log off;
    }

    # --- API ---------------------------------------------------------------
    location /api/ {
        proxy_pass http://backend:8080;
        include /etc/nginx/proxy_params_aura.conf;
    }

    # Brute-force protection on login and registration only.
    location /api/auth/ {
        limit_req zone=auth_limit burst=10 nodelay;
        proxy_pass http://backend:8080;
        include /etc/nginx/proxy_params_aura.conf;
    }

    # --- Everything else: the React SPA ------------------------------------
    location / {
        proxy_pass http://web:80;
        include /etc/nginx/proxy_params_aura.conf;
    }
}
