#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAVA_HOME_DEFAULT="/Users/marv/Library/Java/JavaVirtualMachines/corretto-17.0.19/Contents/Home"
JAVA_HOME="${JAVA_HOME:-$JAVA_HOME_DEFAULT}"
ADB_BIN="${ADB_BIN:-/opt/homebrew/bin/adb}"
EMULATOR_BIN="${EMULATOR_BIN:-/Users/marv/Library/Android/sdk/emulator/emulator}"
AVD_NAME="${AVD_NAME:-Pixel_7a}"
EMULATOR_MEMORY_MB="${EMULATOR_MEMORY_MB:-2048}"
BACKEND_PORT="${BACKEND_PORT:-8080}"
WEB_HOST="${WEB_HOST:-127.0.0.1}"
WEB_PORT="${WEB_PORT:-5174}"

BACKEND_LOG="${ROOT_DIR}/backend/run_app.log"
WEB_LOG="${ROOT_DIR}/web/run_app.log"

# setsid (util-linux) isn't shipped on macOS. When it's available we use it to
# put the backend/web processes in their own session/process group so we can
# kill the whole group on cleanup; when it's not (stock macOS), we fall back
# to backgrounding directly. The cleanup() function already falls back to a
# plain `kill "$PID"` if the process-group kill fails, so this degrades
# gracefully either way.
SETSID_BIN="$(command -v setsid 2>/dev/null || true)"

start_bg() {
  local cmd="$1"
  if [[ -n "${SETSID_BIN}" ]]; then
    setsid bash -c "${cmd}" &
  else
    bash -c "${cmd}" &
  fi
}

# Track PIDs globally
WEB_PID=""
EMULATOR_PID=""

cleanup() {
  echo ""
  echo "==> Stopping all services..."
  
  if [[ -n "${BACKEND_PID:-}" ]] && kill -0 "$BACKEND_PID" 2>/dev/null; then
    echo "==> Stopping backend (PID: $BACKEND_PID)"
    kill -- -$BACKEND_PID 2>/dev/null || kill "$BACKEND_PID" 2>/dev/null || true
  fi
  
  if [[ -n "${WEB_PID:-}" ]] && kill -0 "$WEB_PID" 2>/dev/null; then
    echo "==> Stopping web server (PID: $WEB_PID)"
    kill -- -$WEB_PID 2>/dev/null || kill "$WEB_PID" 2>/dev/null || true
  fi

  if [[ -n "${EMULATOR_PID:-}" ]] && kill -0 "$EMULATOR_PID" 2>/dev/null; then
    echo "==> Stopping Android emulator (PID: $EMULATOR_PID)"
    kill "$EMULATOR_PID" 2>/dev/null || true
  fi
  
  echo "==> Cleanup complete."
}

# Trap EXIT, SIGINT (Ctrl+C), and SIGTERM
trap cleanup EXIT INT TERM

echo "==> Backend: starting Ktor API on http://127.0.0.1:${BACKEND_PORT}"
start_bg "cd '${ROOT_DIR}/backend' && JAVA_HOME='${JAVA_HOME}' ./gradlew run >'${BACKEND_LOG}' 2>&1"
BACKEND_PID=$!
sleep 1
if ! kill -0 "${BACKEND_PID}" 2>/dev/null; then
  echo "!! Backend process died immediately — check ${BACKEND_LOG}" >&2
fi

echo "==> Web: starting Vite dev server on http://${WEB_HOST}:${WEB_PORT}"
start_bg "cd '${ROOT_DIR}/web' && npm run dev -- --host '${WEB_HOST}' --port '${WEB_PORT}' >'${WEB_LOG}' 2>&1"
WEB_PID=$!
sleep 1
if ! kill -0 "${WEB_PID}" 2>/dev/null; then
  echo "!! Web process died immediately — check ${WEB_LOG}" >&2
fi

echo "==> Android: building debug APK"
(
  cd "${ROOT_DIR}/android"
  JAVA_HOME="${JAVA_HOME}" ./gradlew assembleDebug
)

echo "==> Android: checking for a connected device"
ADB_DEVICES_OUTPUT="$("${ADB_BIN}" devices | tail -n +2)"

if echo "${ADB_DEVICES_OUTPUT}" | grep -q "unauthorized$"; then
  echo "!! A device is connected but unauthorized. On the phone, accept the" >&2
  echo "!! 'Allow USB debugging?' prompt (check for it if the screen is locked)," >&2
  echo "!! then re-run this script." >&2
  exit 1
fi

if echo "${ADB_DEVICES_OUTPUT}" | grep -q "offline$"; then
  echo "!! A device is connected but reports 'offline'. Try unplugging and" >&2
  echo "!! reconnecting the USB cable, then re-run this script." >&2
  exit 1
fi

CONNECTED_DEVICE_COUNT="$(echo "${ADB_DEVICES_OUTPUT}" | grep -c "device$" || true)"

if [[ "${CONNECTED_DEVICE_COUNT}" -gt 1 ]]; then
  echo "!! More than one device/emulator is connected; adb won't know which" >&2
  echo "!! one to target. Disconnect the extras (or stop the emulator) and" >&2
  echo "!! re-run this script." >&2
  echo "${ADB_DEVICES_OUTPUT}" >&2
  exit 1
fi

if [[ "${CONNECTED_DEVICE_COUNT}" -eq 1 ]]; then
  echo "==> Android: using the already-connected device (skipping emulator)"
else
  echo "==> Android: no device connected, launching emulator ${AVD_NAME}"
  "${EMULATOR_BIN}" -avd "${AVD_NAME}" -memory "${EMULATOR_MEMORY_MB}" -no-boot-anim >/tmp/run_app-emulator.log 2>&1 &
  EMULATOR_PID=$!
  echo "==> Android: waiting for adb device"
  "${ADB_BIN}" wait-for-device
fi

echo "==> Android: waiting for boot completion"
until [[ "$("${ADB_BIN}" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" == "1" ]]; do
  sleep 2
done

echo "==> Android: installing APK"
"${ADB_BIN}" install -r "${ROOT_DIR}/android/app/build/outputs/apk/debug/app-debug.apk"

echo "==> Android: launching app"
# Debug builds carry a .debug applicationId suffix (see android/app/build.gradle.kts)
# so they install side by side with a release build instead of fighting it
# for the same package name — the activity's own package stays com.beauty.app.
"${ADB_BIN}" shell am start -n com.beauty.app.debug/com.beauty.app.MainActivity

echo
echo "=================================================="
echo "App is running! Press [CTRL+C] to stop everything."
echo "=================================================="
echo "Backend log: ${BACKEND_LOG}"
echo "Web log: ${WEB_LOG}"
echo "Web URL: http://${WEB_HOST}:${WEB_PORT}/"
echo "Backend URL: http://127.0.0.1:${BACKEND_PORT}/"

# This keeps the script running in the terminal until Ctrl+C is pressed
wait
