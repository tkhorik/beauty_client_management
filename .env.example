# ---------------------------------------------------------------------------
# Copy this file to `.env` ON THE VPS ONLY and fill in real values:
#     cp .env.example .env && chmod 600 .env
#
# `.env` is git-ignored. Never commit it. Never paste these values into chat,
# an issue, or a Dockerfile.
# ---------------------------------------------------------------------------

# Public domain the app is served from, without scheme or trailing slash.
DOMAIN=example.com

# External HTTPS port the proxy is published on. Defaults to 443; only change
# this if port 443 is already used by something else on the host (e.g. a
# non-Docker service that needs to keep it). Port 80 is unaffected and always
# stays on 80 for the ACME challenge + HTTP->HTTPS redirect.
HTTPS_PORT=443

# Email Let's Encrypt uses for expiry warnings.
CERTBOT_EMAIL=you@example.com

# --- Database -------------------------------------------------------------
POSTGRES_DB=beautydb
POSTGRES_USER=aura
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME
DB_MAX_POOL_SIZE=10

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
# Changing this invalidates every issued token: all users must log in again.
JWT_SECRET=CHANGE_ME

# --- CORS -----------------------------------------------------------------
# Leave empty for the single-domain setup (web and API share one origin).
# Only fill this in if a different origin must call the API, e.g.
# ALLOWED_ORIGINS=https://admin.example.com
ALLOWED_ORIGINS=

# --- Images ---------------------------------------------------------------
# Set by CI on each deploy. Pin to a commit SHA rather than `latest` so you
# always know exactly what is running and can roll back to a previous tag.
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_USER/aura-backend:latest
WEB_IMAGE=ghcr.io/YOUR_GITHUB_USER/aura-web:latest
