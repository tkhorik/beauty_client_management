# ---------------------------------------------------------------------------
# Copy this file to `.env` ON THE VPS ONLY and fill in real values:
#     cp .env.example .env && chmod 600 .env
#
# `.env` is git-ignored. Never commit it. Never paste these values into chat,
# an issue, or a Dockerfile.
# ---------------------------------------------------------------------------

# Public domain the app is served from, without scheme or trailing slash.
DOMAIN=example.com

# External HTTPS port the proxy is published on. Defaults to 443; only change
# this if port 443 is already used by something else on the host (e.g. a
# non-Docker service that needs to keep it). Port 80 is unaffected and always
# stays on 80 for the ACME challenge + HTTP->HTTPS redirect.
HTTPS_PORT=443

# Email Let's Encrypt uses for expiry warnings.
CERTBOT_EMAIL=you@example.com

# --- Database -------------------------------------------------------------
POSTGRES_DB=beautydb
POSTGRES_USER=aura
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME
DB_MAX_POOL_SIZE=10

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
# Changing this invalidates every issued token: all users must log in again.
JWT_SECRET=CHANGE_ME

# How long an access token stays valid, in minutes. Access tokens are stateless
# and cannot be revoked, so this is the only bound on how long a leaked one
# stays useful. Keep it short — the refresh token below is what keeps users
# signed in, and that one can be revoked.
ACCESS_TOKEN_MINUTES=15

# How long a user stays signed in without re-entering their password, in days.
REFRESH_TOKEN_DAYS=30

# --- Public URL -----------------------------------------------------------
# Canonical public origin, no trailing slash. Include the port only if the
# proxy is not on 443, e.g. https://example.com:8443
#
# Used to build the links inside verification and password-reset emails. It is
# read from config rather than from the request's Host header on purpose:
# otherwise anyone could POST to /api/auth/forgot-password with a forged Host
# and cause the real account owner to be mailed a link to the attacker's site.
# Production refuses to start if this is not https://.
SITE_URL=https://example.com

# --- Organizations (multi-tenant RBAC) ------------------------------------
# Comma-separated addresses promoted to the global SUPER_ADMIN role at startup,
# which grants unrestricted read/write across every organization in the system.
#
# Leave this empty unless you actually need it. Organizations are self-service:
# a user registers, then creates one (becoming its org_admin) or asks to join an
# existing one. Nothing about normal operation requires an account that can read
# every tenant's client records.
#
# There is no API that can grant this role, on purpose — an endpoint capable of
# minting a super admin is an endpoint worth attacking. Promotion is also
# one-directional: removing an address here does NOT demote the account, because
# silently dropping the last super admin during a deploy is the worse failure.
# To revoke, run: UPDATE users SET global_role = 'USER' WHERE email = '...';
SUPER_ADMIN_EMAILS=

# --- Mail (verification + password reset) ---------------------------------
# Required in production: startup fails without MAIL_HOST, because the fallback
# sender writes reset links into the container logs instead of sending them.
#
# Gmail SMTP starter configuration for a low-volume production setup. Use a
# dedicated Google account for the app, enable 2-Step Verification, then create
# a NEW 16-digit App Password at https://myaccount.google.com/apppasswords.
# Never use the normal Google-account password or commit/paste the App Password.
MAIL_PORT=587
MAIL_HOST=smtp.gmail.com
MAIL_USER=your-app-mailbox@gmail.com
MAIL_PASSWORD=YOUR_16_DIGIT_GOOGLE_APP_PASSWORD
MAIL_FROM=your-app-mailbox@gmail.com
MAIL_FROM_NAME=Aura Beauty Log
# Port 587 uses STARTTLS. For implicit TLS on port 465, use false / true.
MAIL_STARTTLS=true
MAIL_SSL_ON_CONNECT=false

# Link lifetimes. The reset window is short by design: a leaked verification
# link only confirms an address, a leaked reset link is a full account takeover.
VERIFICATION_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=60

# --- Enforcing email verification -----------------------------------------
# EMPTY = OFF, and off is the default. An unverified account is unrestricted,
# exactly as it was before this feature existed. This is the kill switch:
# clearing the variable and restarting restores that behaviour with no
# redeploy and no migration to reverse.
#
# Set it to an ISO-8601 local timestamp — e.g. 2026-08-20T09:00:00 — to turn
# enforcement on. From then, an account that has not confirmed its address is
# refused EVERY organization-scoped request, read and write alike, with 403
# EMAIL_NOT_VERIFIED, and its client shows a "confirm your email" screen in
# place of the app. Signing in, reading your own profile, requesting a new
# verification link, changing your password and signing out are never blocked —
# they are the way out of that screen.
#
# The window each account gets depends on when it was created:
#   * registered ON OR AFTER this timestamp -> no window at all. Verification is
#     mandatory from the account's first request; it was told to confirm on
#     screen and by mail at registration.
#   * registered BEFORE it -> this timestamp + VERIFICATION_GRACE_DAYS, during
#     which the clients show a counting-down banner over a working app.
# That split is what makes the switch-on survivable. Giving existing accounts
# their window from THIS date rather than from their own created_at is the only
# reason setting this variable does not lock out your entire user base on the
# next restart.
#
# ORDER OF OPERATIONS: run backend/migrations/004, deploy the backend and the
# clients with this UNSET, confirm the banner is showing, and only then set it.
# Users learn they must re-verify from the banner — nothing mails them.
EMAIL_VERIFICATION_ENFORCED_FROM=

# Only ever applies to accounts that predate EMAIL_VERIFICATION_ENFORCED_FROM.
# A new registration gets no grace regardless of what this is set to.
VERIFICATION_GRACE_DAYS=7

# --- CORS -----------------------------------------------------------------
# Leave empty for the single-domain setup (web and API share one origin).
# Only fill this in if a different origin must call the API, e.g.
# ALLOWED_ORIGINS=https://admin.example.com
ALLOWED_ORIGINS=

# --- Images ---------------------------------------------------------------
# Set by CI on each deploy. Pin to a commit SHA rather than `latest` so you
# always know exactly what is running and can roll back to a previous tag.
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_USER/aura-backend:latest
WEB_IMAGE=ghcr.io/YOUR_GITHUB_USER/aura-web:latest
